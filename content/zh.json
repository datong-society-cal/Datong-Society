    "decal-semester-archive": "<h2 id=\"decal-title\">DeCal 课程</h2><section class=\"event-card\" id=\"decal-2026-fall\"><div class=\"event-head\"><h3>Through the Camera: 20th-Century China in Transition</h3><div class=\"event-meta\"><span class=\"event-tag\">DeCal</span><span class=\"event-date\">2026 年秋</span></div></div><p class=\"event-desc\">Hist 198 · 通过影像探索转型中的二十世纪中国。</p><div class=\"event-gallery\"><a href=\"images/events/2026-decal/flyer_Decal.jpg\" data-cap=\"2026 年秋 — Through the Camera: 20th-Century China in Transition\"><img loading=\"lazy\" decoding=\"async\" src=\"images/events/2026-decal/flyer_Decal.jpg\" alt=\"2026 年秋 — Through the Camera: 20th-Century China in Transition\" /></a></div></section><section class=\"event-card\" id=\"decal-2024-spring\"><div class=\"event-head\"><h3>Contemporary China: A History of Unfinished Tales</h3><div class=\"event-meta\"><span class=\"event-tag\">DeCal</span><span class=\"event-date\">2024 年春</span></div></div><p class=\"event-desc\">Global Studies 198 · 2 学分。通过影像、讨论与嘉宾讲座，学习中华人民共和国历史及当代社会议题。</p></section><section class=\"event-card\" id=\"decal-2022-fall\"><div class=\"event-head\"><h3>Contemporary China: A History of Unfinished Tales</h3><div class=\"event-meta\"><span class=\"event-tag\">DeCal</span><span class=\"event-date\">2022 年秋</span></div></div><p class=\"event-desc\">Global Studies 198 · 1 学分。以讨论探究塑造当代中国的历史与社会进程。</p><div class=\"event-gallery\"><a href=\"images/events/course-decal-contemporary-china/01.jpg\" data-cap=\"2022 年秋 — Contemporary China: A History of Unfinished Tales\"><img loading=\"lazy\" decoding=\"async\" src=\"images/events/course-decal-contemporary-china/01.jpg\" alt=\"2022 年秋 — Contemporary China: A History of Unfinished Tales\" /></a></div></section><section class=\"event-card\" id=\"decal-2021-spring\"><div class=\"event-head\"><h3>Contemporary China: A History and Many Stories</h3><div class=\"event-meta\"><span class=\"event-tag\">DeCal</span><span class=\"event-date\">2021 年春</span></div></div><p class=\"event-desc\">Global Studies 198 · 2 学分。线上课程聚焦 1949 年后的中国，比较不同历史叙事及较少被呈现的视角。</p></section><section class=\"event-card\" id=\"decal-2020-spring\"><div class=\"event-head\"><h3>Contemporary China: A History and Many Stories</h3><div class=\"event-meta\"><span class=\"event-tag\">DeCal</span><span class=\"event-date\">2020 年春</span></div></div><p class=\"event-desc\">Global Studies 198 · 1 学分。以学生主导的讨论探索当代中国的社会与政治议题。</p><div class=\"event-gallery\"><a href=\"images/events/course-decal-contemporary-china/02.jpg\" data-cap=\"2020 年春 — Contemporary China: A History and Many Stories\"><img loading=\"lazy\" decoding=\"async\" src=\"images/events/course-decal-contemporary-china/02.jpg\" alt=\"2020 年春 — Contemporary China: A History and Many Stories\" /></a></div></section><section class=\"event-card\" id=\"decal-2017-spring\"><div class=\"event-head\"><h3>Journey to China: Exploration Behind Icons</h3><div class=\"event-meta\"><span class=\"event-tag\">DeCal</span><span class=\"event-date\">2017 年春</span></div></div></section><section class=\"event-card\" id=\"decal-2016-spring\"><div class=\"event-head\"><h3>Journey to China: Exploration Behind Icons</h3><div class=\"event-meta\"><span class=\"event-tag\">DeCal</span><span class=\"event-date\">2016 年春</span></div></div></section>",
    "chsa-planned-visit": "<article class=\"event-card planned-event\" id=\"chsa-visit\"><div class=\"event-meta\"><span class=\"event-tag\">近期活动</span><span><time datetime=\"2026-11-14\">2026 年 11 月 14 日</time> · 日期可能调整</span></div><h3>唐人街与 CHSA 参访</h3><p>旧金山唐人街</p><p class=\"event-desc\">与 CHSA 一同探索华人移民历史，活动包括唐人街街区步行导览，或由讲解员带领参观李小龙主题展览。</p></article>",
    "east-asian-cultural-salon": "<article class=\"event-card planned-event\" id=\"east-asian-cultural-salon\"><div class=\"event-meta\"><span class=\"event-tag\">近期活动</span><span><time datetime=\"2026-11-16\">2026 年 11 月 16 日</time> · 下午 3:30–6:30 · 太平洋时间</span></div><h3>东亚文化沙龙</h3><p>ASUC Senate Chambers，Eshleman Hall · UC Berkeley</p><p class=\"event-desc\">沙龙将包括学生主讲的分享与展台活动，汇聚来自不同学术与文化背景的本科生和研究生。</p></article>"
